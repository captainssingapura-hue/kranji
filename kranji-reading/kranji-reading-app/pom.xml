<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
        <artifactId>kranji-reading</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kranji-reading-app</artifactId>

    <description>
        The Homing layer: studio, workspace specs, widgets, and the server.
        The only module in the tree that ships served modules, and therefore
        the only one carrying a Crate.

        Conformance rules and engine are compile-scope rather than test-scope
        so the policy and the domain rule live in main alongside the crate —
        the same config is later read by a build-time report export.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-reading-model</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-reading-content</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!--
            The published library, as a discovered root rather than an API.

            Runtime scope for the same reason the gloss modules have it: the app
            compiles against ArticleLibrary and never names a root, so which
            library is served is a deployment question. Both roots are on the
            classpath here and the reader gets this one, because DemoLibrary
            ranks above 0 and yields - see kranji.reading.library.Libraries.
        -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-library-all</artifactId>
            <version>${project.parent.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            The glosses, as an SPI implementation rather than an API.

            Runtime scope on purpose: the app compiles against ZiCollection in
            kranji-core and never names a collection, so which collections exist
            is a deployment question. Compile scope would let a widget reach
            past the seam and call HandCrafted directly, and the first one that
            did would pin the app to one body of data.
        -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-gloss</artifactId>
            <version>${project.parent.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-gloss-seed</artifactId>
            <version>${project.parent.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-gloss-layered</artifactId>
            <version>${project.parent.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-studio-starter</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- RelationGrid: the phonic source widget renders extraction output on it. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-relation-grid</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-engine</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <!--
            The article check, as a base class. Test scope: nothing the app
            ships knows this exists. The per-group subclasses live in the
            library modules; this one is the only place every root on one
            classpath is asked at once.
        -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-library-testkit</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Runs served JavaScript on GraalVM inside ordinary JUnit. The cell
            scanner is a rule the browser applies, so it is tested the way the
            Java it was ported from is tested - including a parity test that
            reads both on the same articles.
        -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ssjs-test-fixtures</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
